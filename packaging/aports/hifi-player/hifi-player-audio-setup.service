[Unit]
Description=Bit-perfect player audio environment (USB host mode, RT, governors)
After=sound.target systemd-udevd.service
Wants=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/hifi-player-audio-setup start
ExecStop=/usr/bin/hifi-player-audio-setup stop

[Install]
WantedBy=multi-user.target
