+
+typedef struct TfaEqFilter {
+	TfaBiquad_t biquad;
+	uint8_t enabled;
+	uint8_t type;		// (== enum FilterTypes, assure 8bits length)
+	float cutOffFreq;	// cut off frequency, // range: [100.0 4000.0]
