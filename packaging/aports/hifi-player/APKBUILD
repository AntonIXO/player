# Maintainer: Anton <fourth@devpins.org>
pkgname=hifi-player
pkgver=0.1.0
pkgrel=13
pkgdesc="Bit-perfect lossless music player (player-gtk + player-cli) for Poco F1 + Chord Mojo 2"
url="https://github.com/AntonIXO/player"
# beryllium / SDM845 only: the bundled audio-tuning files are device-specific.
arch="aarch64"
license="MIT"
# alsa-lib and the GTK4/libadwaita runtime libraries are added automatically by
# abuild's shared-library tracing, so they are not listed here. alsa-utils is for
# on-device verification (aplay / speaker-test). The RT / governor / IRQ tuning is
# self-contained in the systemd service, so there is no rtirq/cpupower dependency.
# adwaita-icon-theme is a *data* dependency (SVG symbolic icons), NOT a shared
# library, so abuild's tracing won't pick it up — list it explicitly. The GTK shell
# looks up Adwaita symbolic names at runtime (e.g. emblem-favorite-symbolic for the
# "love" pill); without the theme GTK falls back to hicolor and the icon is blank.
# openssh-server + avahi: the one-touch "music sync" share (hifi-share) — sshd serves
# the phone's storage over SFTP for drag-and-drop from GNOME Nautilus, avahi advertises
# it as _sftp-ssh._tcp so it auto-appears in Nautilus' network view. NetworkManager
# (the Wi-Fi half) is already part of the Phosh image.
depends="alsa-utils adwaita-icon-theme openssh-server avahi iw"
# llvm:   provides /usr/bin/llvm-profdata to merge PGO profiles. The UNVERSIONED
#         `llvm` package tracks Alpine's default LLVM — the same one `rust` is built
#         against — so it always matches rustc's raw-profile format (LLVM 22 here).
#         If it's ever still missing, build() falls back to a plain release build.
# ffmpeg: build()'s bit-perfect gate decodes each testfile and byte-compares the
#         output against ffmpeg's, refusing to package a binary whose samples differ
#         (the PGO/BOLT safety net).
# xvfb:   headless X server for the UI PGO pass (_pgo_ui=1) — runs the instrumented
#         player-gtk `--bench` so PGO also covers the UI's OWN code. Best-effort: if
#         the bench can't run, only the shared decode/library code is profiled.
# NOTE:   BOLT (_bolt=1) needs `llvm-bolt` + `merge-fdata` (Alpine packages neither)
#         AND, for instrument mode, an *aarch64* libbolt_rt_instr.a — BOLT links that
#         runtime INTO the target, so it must match the TARGET arch even though the
#         tool itself can be x86_64. `scripts/pmb-build-pgo.sh --bolt` wires both up:
#         it RO-binds, at /mnt/x86-bolt in a bin/lib layout, the x86_64 llvm-bolt +
#         merge-fdata (run NATIVELY via their loader — fast) under bin/, and the
#         aarch64 libbolt_rt_instr.a (lifted from a downloaded aarch64 LLVM,
#         LLVM-*-Linux-ARM64) under lib/, where BOLT resolves it. The host tool
#         rewrites by ELF arch; only the instrumented binary's training run is
#         emulated. Missing tools OR runtime => BOLT auto-skips and PGO still applies.
#         (Alt: BOLT a host/on-device build: scripts/pgo-bolt-build.sh --bolt)
# meson + phosh-dev/gtk+3.0-dev/libhandy1-dev/glib-dev: the Phosh quick-settings
# plugin (the system-curtain "Music sync" button) is an out-of-tree GModule built
# in build(). Phosh is GTK3 + libhandy (not GTK4). The plugin build is BEST-EFFORT:
# if phosh-plugins.pc isn't available for this Phosh release, build() skips the tile
# and the share still works via `hifi-share` / the CLI (see the gating in build()).
makedepends="
	cargo
	rust
	llvm
	gtk4.0-dev
	libadwaita-dev
	alsa-lib-dev
	ffmpeg
	xvfb
	meson
	phosh-dev
	gtk+3.0-dev
	libhandy1-dev
	glib-dev
"
install="$pkgname.post-install"
# net:    cargo fetches crate sources in prepare() (build() then runs offline).
# !check: the test suite needs an ALSA loopback device, unavailable in the chroot.
options="net !check"
# Local-source build: run
#   pmbootstrap build --src=/home/antonix/player hifi-player
# which rsyncs the working tree into $builddir. (A tagged release would instead add
# a "$pkgname-$pkgver.tar.gz::<github-archive-url>" entry to source= and drop --src.)
source="
	hifi-player-audio-setup
	hifi-player-audio-setup.service
	hifi-player-sleep-hook
	hifi-player.preset
	hifi-player.desktop
	hifi-player.svg
	99-mojo2-nopulse.rules
	99-cpu-dma-latency.rules
	99-volume-keys.rules
	99-audio.conf
	audio.conf
	99-audio-sysctl.conf
	90-audio-cmdline.conf
	hifi-share
	hifi-share.service
	hifi-share.conf
	hifi-share-avahi.service
	hifi-share-sshd.conf
	hifi-share-polkit.rules
	hifi-usb-mode
	hifi-usb-mode@.service
	hifi-usb-mode-polkit.rules
	zz-hifi-sync.gschema.override
"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
	default_prepare
	cd "$builddir"
	# Pre-fetch every crate dependency now; build() is offline (--frozen).
	cargo fetch --locked
}

# --- PGO/BOLT toggles --------------------------------------------------------
# _pgo=1: Profile-Guided Optimization (default). Auto-collected here: instrument
#         player-cli, run a branch-heavy headless workload — over the REAL music
#         library when one is bind-mounted (scripts/pmb-build-pgo.sh → /mnt/pgo-music:
#         varied FLAC/MP3/ALAC decode + seek, bounded SACD .iso DST, real-metadata
#         scan + fuzzy/FTS search), else synth clips — NOT flat PCM (~0 gain), merge,
#         then rebuild BOTH binaries with the profile (player-gtk benefits on the
#         shared decode/library code via function matching). Falls back to a plain
#         build if material or llvm-profdata are missing, or rustc lacks the profiler
#         runtime — pmbootstrap build never breaks because of PGO.
# _bolt=1: also BOLT the optimized binaries (opt-in). Needs llvm-bolt + merge-fdata
#         and an aarch64 instrumentation runtime (native, or host-staged at
#         /mnt/x86-bolt — see NOTE above). BOLTs player-cli (trained by _workload)
#         and, when _pgo_ui=1, player-gtk too (trained by the same headless Xvfb UI
#         bench PGO uses) — so BOLT covers everything PGO does.
# Both only change code LAYOUT, never numeric results — the bit-perfect gate below
# re-proves byte-equality vs ffmpeg before the binary is allowed to be packaged.
_pgo=1
_bolt=1
# _pgo_ui=1: also profile player-gtk's OWN UI code (page build, list models,
#         layout, album/hero rescale, search render) — not just the shared
#         decode/library code. Instruments player-gtk too and runs it headless via
#         `--bench` under Xvfb during collection. Costs one extra (instrumented)
#         player-gtk build under qemu; set 0 to skip if builds get too slow. The
#         lto="off" PGO profile is what makes profiling extra crates safe here
#         (no ThinLTO ProfileSummary conflicts — see Cargo.toml / rust#115344).
_pgo_ui=1

# The whole pipeline builds the `release-pgo` cargo profile (= release but
# strip=false, since BOLT needs symbols/relocations); abuild strips the installed
# binaries afterwards anyway, so the shipped size is unchanged.
_cargo_profile="release-pgo"
_outdir="target/$_cargo_profile"

# Directory of training/gate clips, set by _prep_testdata (global, sh-scoped).
_TESTDIR=""

# Real PGO corpus: a user music library bind-mounted into the chroot (RO at
# /mnt/pgo-music by scripts/pmb-build-pgo.sh; $PLAYER_PGO_MUSIC overrides the
# path). When present, _workload trains on real FLAC/MP3/ALAC + the SACD .iso
# DST decoder + a real Cyrillic-tagged index — far richer than the synth clips.
# Empty = portable synth-only default; the build never depends on it existing.
_PGO_MUSIC=""
_detect_corpus() {
	for _d in "$PLAYER_PGO_MUSIC" /mnt/pgo-music; do
		[ -n "$_d" ] && [ -d "$_d" ] || continue
		if find "$_d" -type f \( -iname '*.flac' -o -iname '*.mp3' \
			-o -iname '*.m4a' -o -iname '*.iso' \) 2>/dev/null | head -n1 | grep -q .; then
			_PGO_MUSIC="$_d"; return 0
		fi
	done
	return 1
}

# Synthesize one clip with ffmpeg: $1=outfile $2=rate $3=sample_fmt $4=codec.
# Tones + pink noise so FLAC residuals are non-trivial (exercises the real decode
# branches); flat PCM compresses to nothing and shows ~0 PGO gain (.jules/bolt.md).
# $4 must be set explicitly — for WAV, -sample_fmt alone won't pick a 32-bit
# encoder (ffmpeg defaults to pcm_s16le and the encode fails).
_synth() {
	ffmpeg -v error -y \
		-f lavfi -i "sine=frequency=440:duration=15" \
		-f lavfi -i "anoisesrc=duration=15:color=pink:amplitude=0.4" \
		-filter_complex "amix=inputs=2:duration=shortest" \
		-ac 2 -ar "$2" -sample_fmt "$3" -c:a "$4" "$1"
}

# Pick training/gate material. Prefer the repo's real fixtures — but testfiles/ is
# gitignored, so `pmbootstrap --src` doesn't ship it; in that case synthesize a
# small varied set with ffmpeg so PGO and the bit-perfect gate are self-contained.
_prep_testdata() {
	if [ -d testfiles ] && ls testfiles/*.flac >/dev/null 2>&1; then
		_TESTDIR="testfiles"; return 0
	fi
	command -v ffmpeg >/dev/null || return 1
	_TESTDIR="$builddir/target/.testdata"; rm -rf "$_TESTDIR"; mkdir -p "$_TESTDIR" || return 1
	_synth "$_TESTDIR/train_s16_44k.flac" 44100 s16 flac      || return 1
	_synth "$_TESTDIR/train_s16_96k.flac" 96000 s16 flac      || true
	_synth "$_TESTDIR/train_s32_44k.wav"  44100 s32 pcm_s32le || true
	_synth "$_TESTDIR/train_s16_44k.wav"  44100 s16 pcm_s16le || true
	[ -f "$_TESTDIR/train_s16_44k.flac" ] || return 1
}

# Synthetic workload over $_TESTDIR — the portable fallback, and an always-run
# baseline (adds WAV + rate variety the real library may lack). $1 = player-cli.
_workload_synth() {
	_cli="$1"
	_db="$builddir/target/.pgo-lib.db"; rm -f "$_db"
	_n=0; while [ "$_n" -lt 5 ]; do
		for _f in "$_TESTDIR"/*.flac "$_TESTDIR"/*.wav; do
			[ -f "$_f" ] && "$_cli" dump "$_f" -o /dev/null >/dev/null 2>&1 || true
		done
		_n=$((_n + 1))
	done
	for _f in "$_TESTDIR"/*; do [ -f "$_f" ] && "$_cli" probe "$_f" >/dev/null 2>&1 || true; done
	"$_cli" scan "$_TESTDIR" --db "$_db" --force >/dev/null 2>&1 || true
	for _q in flac wav train sine noise test album the love jazz remix 2024; do
		for _filt in all tracks albums artists; do
			"$_cli" search "$_q" --db "$_db" --filter "$_filt" >/dev/null 2>&1 || true
		done
	done
	"$_cli" library-stats --db "$_db" >/dev/null 2>&1 || true
	rm -f "$_db"
}

# Rich workload over the REAL mounted library ($_PGO_MUSIC): varied real
# FLAC/MP3/ALAC decode (+ seek/rewind), the bounded SACD .iso DST decoder, a
# library scan over real Cyrillic-tagged metadata + embedded art (lofty/FTS5),
# and fuzzy + FTS search over a realistically sized index. Every decode is
# bounded (--seconds) so qemu-user stays tractable; no sample is altered.
# Tunable: PLAYER_PGO_DECODE_SECS / _MAX_PER_CODEC / _ISO_START / _ISO_SECS /
# _ISO_REWIND_FROM / _ISO_REWIND_TO / _ISO_REWIND_SECS (the .iso backward-seek pass).
_workload_real() {
	_cli="$1"
	_secs="${PLAYER_PGO_DECODE_SECS:-15}"
	_maxpc="${PLAYER_PGO_MAX_PER_CODEC:-0}"   # 0 = every track of each codec
	_iso_start="${PLAYER_PGO_ISO_START:-20}"
	_iso_secs="${PLAYER_PGO_ISO_SECS:-25}"
	_iso_rw_from="${PLAYER_PGO_ISO_REWIND_FROM:-60}"  # decode forward from here,
	_iso_rw_to="${PLAYER_PGO_ISO_REWIND_TO:-5}"       # then seek BACK to here
	_iso_rw_secs="${PLAYER_PGO_ISO_REWIND_SECS:-8}"   # bounded so qemu stays sane
	_db="$builddir/target/.pgo-real.db"; rm -f "$_db"
	if [ "$_maxpc" -gt 0 ]; then _cov="≤${_maxpc}/codec"; else _cov="all tracks"; fi
	msg "PGO: real-corpus workload (decode ${_secs}s × ${_cov}, iso ${_iso_secs}s) over $_PGO_MUSIC"

	# Library index: real tags, embedded art, .cue, Unicode metadata, FTS5 build.
	"$_cli" scan "$_PGO_MUSIC" --db "$_db" --force >/dev/null 2>&1 || true
	"$_cli" library-stats --db "$_db" >/dev/null 2>&1 || true

	# Search: fuzzy + FTS over the real index (Latin + Cyrillic, prefix/typo).
	for _q in the love live remix piano jazz rock 2024 vol mix acoustic концерт любовь музыка лучшее симфония; do
		for _filt in all tracks albums artists; do
			"$_cli" search "$_q" --db "$_db" --filter "$_filt" >/dev/null 2>&1 || true
		done
	done

	# Decode every track of each codec (PLAYER_PGO_MAX_PER_CODEC=0), each bounded
	# to _secs; on the first few of each, add seek offsets to profile the rewind
	# path. Set _MAX_PER_CODEC>0 to cap per codec if qemu builds get too slow.
	# `while read` (not a glob) handles spaces/Unicode in real filenames safely.
	for _ext in flac mp3 m4a; do
		if [ "$_maxpc" -gt 0 ]; then
			find "$_PGO_MUSIC" -type f -iname "*.$_ext" 2>/dev/null | head -n "$_maxpc"
		else
			find "$_PGO_MUSIC" -type f -iname "*.$_ext" 2>/dev/null
		fi | (
			_i=0
			while IFS= read -r _f; do
				"$_cli" dump "$_f" -o /dev/null --seconds "$_secs" >/dev/null 2>&1 || true
				if [ "$_i" -lt 3 ]; then
					"$_cli" probe "$_f" >/dev/null 2>&1 || true
					"$_cli" dump "$_f" -o /dev/null --start 10 --seconds "$_secs" >/dev/null 2>&1 || true
					"$_cli" dump "$_f" -o /dev/null --start 45 --seconds 5 >/dev/null 2>&1 || true
				fi
				_i=$((_i + 1))
			done
		)
	done

	# SACD .iso: bounded DST decode (arithmetic coder + adaptive FIR) — the
	# branchiest code in the project. Bounded so qemu stays tractable.
	find "$_PGO_MUSIC" -type f -iname '*.iso' 2>/dev/null | head -n 2 | while IFS= read -r _f; do
		"$_cli" probe "$_f" >/dev/null 2>&1 || true
		"$_cli" dump "$_f" -o /dev/null --start "$_iso_start" --seconds "$_iso_secs" >/dev/null 2>&1 || true
		# Rewind: decode forward from a later offset, then seek BACK — exercises the
		# SacdTrackReader sparse frame→sector backward-seek index (the rewind path
		# that skips a full rescan). Bounded short; never alters samples.
		"$_cli" dump "$_f" -o /dev/null --start "$_iso_rw_from" --seconds "$_iso_rw_secs" \
			--rewind "$_iso_rw_to" >/dev/null 2>&1 || true
	done

	rm -f "$_db"
}

# Dispatcher: the rich real-library pass when a corpus is mounted, plus the cheap
# synth baseline (extra WAV/rate coverage) always. $1 = player-cli.
_workload() {
	[ -n "$_PGO_MUSIC" ] && _workload_real "$1"
	_workload_synth "$1"
}

# Headless UI exerciser for PGO: run the INSTRUMENTED player-gtk through its own
# hot paths (`--bench`: page switches, search, album-grid + hero rescale, detail
# pages) under a throwaway Xvfb, so profile-generate collects coverage for
# player-gtk's OWN code (the shared decode/library code is already covered by the
# player-cli workload). Fully isolated (its own HOME/XDG) and best-effort — if
# Xvfb or the bench can't run, it's skipped and everything else still gets PGO.
# Runs in a () subshell so its env never leaks. $1 = instrumented player-gtk.
_workload_gtk() (
	[ "$_pgo_ui" = 1 ] || exit 0
	_gtk="$1"; [ -x "$_gtk" ] || exit 0
	command -v Xvfb >/dev/null 2>&1 || { warning "UI PGO skipped: Xvfb not found"; exit 0; }
	# Isolated throwaway library so the UI has real rows + art to render without
	# touching anything real. build_ui reads the XDG default paths.
	_h="$builddir/target/.gtkbench"; rm -rf "$_h"
	export HOME="$_h" XDG_DATA_HOME="$_h/share" XDG_CACHE_HOME="$_h/cache" XDG_RUNTIME_DIR="$_h/run"
	mkdir -p "$XDG_DATA_HOME/player" "$XDG_CACHE_HOME/player" "$XDG_RUNTIME_DIR"
	chmod 700 "$XDG_RUNTIME_DIR"
	# Populate the default-path DB from the real corpus (best-effort, bounded).
	[ -n "$_PGO_MUSIC" ] && "$_outdir/player-cli" scan "$_PGO_MUSIC" --force >/dev/null 2>&1 || true
	msg "PGO: UI bench (player-gtk --bench under Xvfb)"
	Xvfb :99 -screen 0 720x1440x24 >/dev/null 2>&1 &
	_xp=$!
	# LLVM_PROFILE_FILE is inherited (exported by _pgo_build) and absolute, so the
	# gtk profraw lands beside the cli profraw; %p/%m keep the binaries distinct.
	export DISPLAY=:99 GDK_BACKEND=x11 PLAYER_GTK_BENCH=1 \
		PLAYER_GTK_BENCH_SECS="${PLAYER_PGO_GTK_SECS:-25}"
	# The bench self-quits via its watchdog; `timeout` is a hard backstop so a
	# stuck UI can never stall the build.
	timeout 120 "$_gtk" >/dev/null 2>&1 || true
	kill "$_xp" 2>/dev/null || true
	exit 0
)

# Resolve the BOLT tools into $_LLVM_BOLT / $_MERGE_FDATA (which may be multi-word,
# so callers expand them UNQUOTED) and set $_bolt_can_instr (1 = instrument mode is
# usable, i.e. a TARGET-arch libbolt_rt_instr.a is available to link into the binary).
# Prefer a native llvm-bolt on PATH (an on-device aarch64 build, if Alpine ever
# packages it — its own runtime is target-arch, so instrument works). Otherwise use a
# HOST toolchain bind-mounted at $PLAYER_BOLT_DIR (default /mnt/x86-bolt) by
# scripts/pmb-build-pgo.sh --bolt in a bin/lib layout: the x86_64 llvm-bolt is run via
# its loader from bin/ (fast, native) and BOLT resolves its runtime as <dir>/lib/
# libbolt_rt_instr.a. That runtime is linked INTO the aarch64 target, so it must be the
# aarch64 build (staged from a downloaded aarch64 LLVM); present => instrument works
# cross-arch (proven: x86_64 tool + aarch64 runtime). Returns non-zero if no tools.
_resolve_bolt() {
	_bolt_can_instr=0
	if command -v llvm-bolt >/dev/null && command -v merge-fdata >/dev/null; then
		_LLVM_BOLT="llvm-bolt"; _MERGE_FDATA="merge-fdata"
		_bolt_can_instr=1   # native: its own (target-arch) runtime is installed
		return 0
	fi
	_bd_dir="${PLAYER_BOLT_DIR:-/mnt/x86-bolt}"; _bd_ld="$_bd_dir/bin/ld-linux-x86-64.so.2"
	if [ -x "$_bd_dir/bin/llvm-bolt" ] && [ -x "$_bd_dir/bin/merge-fdata" ] && [ -x "$_bd_ld" ]; then
		_LLVM_BOLT="$_bd_ld --library-path $_bd_dir/bin $_bd_dir/bin/llvm-bolt"
		_MERGE_FDATA="$_bd_ld --library-path $_bd_dir/bin $_bd_dir/bin/merge-fdata"
		[ -f "$_bd_dir/lib/libbolt_rt_instr.a" ] && _bolt_can_instr=1
		return 0
	fi
	return 1
}

# BOLT one binary in place: $1=binary path, $2=short tag, $3=name of the training
# function (invoked with the INSTRUMENTED binary as its arg, so it emits fdata).
# instrument → train → merge-fdata → optimize. Layout-only (the bit-perfect gate
# re-proves byte-equality afterwards). Returns non-zero on any failure; the caller
# warns and keeps the PGO-only binary. Assumes _resolve_bolt already ran.
#
# musl does NOT call the main program's DT_FINI (it terminates via .fini_array), and
# BOLT's default profile dump is a DT_FINI finalizer — so on Alpine the counters are
# collected but never written: empty fdata, BOLT "fails" (verified on-target). Fix:
# --instrumentation-sleep-time=N spawns a watcher that flushes the profile every N
# seconds, independent of DT_FINI; --instrumentation-no-counters-clear keeps the
# counts cumulative so the per-pid file always holds the FULL profile (bolt's
# instr.cpp: "Time to sleep across dumps" / "Do not clear counters across dumps").
# N is small so even mid-length decodes get a dump under qemu; the long real-corpus
# decodes run many seconds and dump repeatedly. Override via PLAYER_BOLT_SLEEP.
_bolt_one() {
	_bin="$1"; _tag="$2"; _train="$3"
	_sleep="${PLAYER_BOLT_SLEEP:-2}"
	[ -x "$_bin" ] || return 1
	_bd="$builddir/target/.bolt-$_tag"; rm -rf "$_bd"; mkdir -p "$_bd" || return 1
	_fdata="$_bd/$_tag.fdata"
	# --instrumentation-file-append-pid (per-pid dump AT EXIT) is what musl breaks and
	# is mutually exclusive with --instrumentation-sleep-time anyway, so use sleep-time
	# alone. But sleep-time writes ONE shared file, and our training is many SEQUENTIAL
	# invocations that would each overwrite it. So wrap the binary: after each run,
	# snapshot the (cumulative) fdata to a unique name; merge them all at the end.
	# Short runs (< sleep-time) dump nothing and are skipped — fine, the long decode/
	# scan phases are the hot code BOLT cares about.
	$_LLVM_BOLT "$_bin" -instrument --instrumentation-file="$_fdata" \
		--instrumentation-sleep-time="$_sleep" --instrumentation-no-counters-clear \
		-o "$_bin.inst" || return 1
	_wrap="$_bd/run.sh"
	cat > "$_wrap" <<EOF
#!/bin/sh
"$_bin.inst" "\$@"; _rc=\$?
[ -f "$_fdata" ] && mv -f "$_fdata" "\$(mktemp -u "$_fdata.XXXXXX")" 2>/dev/null
exit \$_rc
EOF
	chmod +x "$_wrap"
	"$_train" "$_wrap" || true
	[ -f "$_fdata" ] && mv -f "$_fdata" "$_fdata.final" 2>/dev/null
	[ -n "$(find "$_bd" -name "$_tag.fdata.*" 2>/dev/null)" ] || { rm -f "$_bin.inst"; return 1; }
	$_MERGE_FDATA "$_bd/$_tag".fdata.* > "$_bd/merged.fdata" || return 1
	$_LLVM_BOLT "$_bin" -o "$_bin.bolt" -data="$_bd/merged.fdata" \
		-reorder-blocks=ext-tsp -reorder-functions=hfsort \
		-split-functions -split-all-cold -icf=1 || return 1
	mv "$_bin.bolt" "$_bin"; rm -f "$_bin.inst"
}

# Full PGO build. Runs inside an `if` so errexit is off and we can fall back; each
# bail prints a SPECIFIC reason so a skip never misattributes its cause.
_pgo_build() {
	[ -n "$_TESTDIR" ] || { warning "PGO skipped: no training material"; return 1; }
	# Match llvm-profdata to rustc's LLVM major (the raw-profile format is version
	# specific); prefer the versioned tool/path over an unversioned default.
	_major="$(rustc -vV | sed -n 's/^LLVM version: \([0-9]*\).*/\1/p')"
	_profdata=""
	for _c in "/usr/lib/llvm$_major/bin/llvm-profdata" "llvm-profdata-$_major" llvm-profdata; do
		if [ -x "$_c" ]; then _profdata="$_c"; break; fi
		_p="$(command -v "$_c" 2>/dev/null || true)"; [ -n "$_p" ] && { _profdata="$_p"; break; }
	done
	[ -z "$_profdata" ] && _profdata="$(ls /usr/lib/llvm*/bin/llvm-profdata 2>/dev/null | head -n1)"
	[ -n "$_profdata" ] || { warning "PGO skipped: llvm-profdata not found — add 'llvm$_major' (or 'llvm') to makedepends"; return 1; }
	_prof="$builddir/target/.pgo"; rm -rf "$_prof"; mkdir -p "$_prof" || return 1
	# Instrument player-cli always; player-gtk too when _pgo_ui=1 (so the UI bench
	# can collect coverage for the UI's own code). Unquoted on purpose to expand
	# into separate -p args.
	_instr="-p player-cli"
	[ "$_pgo_ui" = 1 ] && _instr="$_instr -p player-gtk"
	msg "PGO: instrumenting$_instr (profdata=$_profdata; material=$_TESTDIR)"
	RUSTFLAGS="$_base_rustflags -C profile-generate=$_prof" \
		cargo build --profile "$_cargo_profile" --frozen $_instr \
		|| { warning "PGO skipped: instrumented build failed (rustc without profiler runtime?)"; return 1; }
	msg "PGO: collecting profiles"
	export LLVM_PROFILE_FILE="$_prof/pgo-%p-%m.profraw"
	_workload "$_outdir/player-cli" || true
	_workload_gtk "$_outdir/player-gtk" || true
	unset LLVM_PROFILE_FILE
	[ -n "$(find "$_prof" -name '*.profraw' 2>/dev/null)" ] \
		|| { warning "PGO skipped: no .profraw produced (could not run instrumented binary?)"; return 1; }
	"$_profdata" merge -o "$_prof/merged.profdata" "$_prof" \
		|| { warning "PGO skipped: profile merge failed (llvm-profdata vs rustc LLVM $_major mismatch?)"; return 1; }
	_use="-C profile-use=$_prof/merged.profdata"
	[ "$_bolt" = 1 ] && _use="$_use -C link-args=-Wl,-q"
	msg "PGO: building optimized player-gtk + player-cli"
	RUSTFLAGS="$_base_rustflags $_use" \
		cargo build --profile "$_cargo_profile" --frozen -p player-gtk -p player-cli \
		|| { warning "PGO skipped: optimized build failed"; return 1; }
	if [ "$_bolt" = 1 ]; then
		if ! _resolve_bolt; then
			warning "BOLT skipped (no llvm-bolt; run scripts/pmb-build-pgo.sh --bolt to bind-mount the host toolchain at /mnt/x86-bolt)"
		elif [ "$_bolt_can_instr" != 1 ]; then
			# Instrumentation links an aarch64 libbolt_rt_instr.a into the target; the
			# x86_64 host toolchain ships only an x86_64 one. Stage an aarch64 runtime
			# (pmb-build-pgo.sh --bolt lifts it from a downloaded aarch64 LLVM) or this
			# stays PGO-only. Don't waste qemu instrument passes failing on it.
			warning "BOLT skipped: no aarch64 libbolt_rt_instr.a at ${_bd_dir:-/mnt/x86-bolt}/lib (need an aarch64 LLVM; see scripts/pmb-build-pgo.sh --bolt). PGO is applied."
		else
			_bolt_one "$_outdir/player-cli" cli _workload \
				&& msg "BOLT: player-cli optimized" || warning "BOLT: player-cli failed (kept PGO binary)"
			# Same coverage as PGO: also BOLT the UI binary, trained by the very
			# same headless Xvfb bench, whenever UI profiling is on.
			if [ "$_pgo_ui" = 1 ]; then
				_bolt_one "$_outdir/player-gtk" gtk _workload_gtk \
					&& msg "BOLT: player-gtk optimized" || warning "BOLT: player-gtk skipped (UI bench/Xvfb unavailable)"
			fi
		fi
	fi
	return 0
}

# Bit-perfect safety net: decode each clip and byte-compare vs ffmpeg. A
# difference means PGO/BOLT (or anything) altered samples — refuse to package.
_bitperfect_gate() {
	command -v ffmpeg >/dev/null || { warning "bit-perfect gate skipped (no ffmpeg)"; return 0; }
	[ -n "$_TESTDIR" ] && [ -d "$_TESTDIR" ] || { warning "bit-perfect gate skipped (no test material)"; return 0; }
	_cli="$_outdir/player-cli"; _t="$builddir/target/.gate"; rm -rf "$_t"; mkdir -p "$_t"
	_rc=0; _checked=0
	for _f in "$_TESTDIR"/*.flac "$_TESTDIR"/*.wav; do
		[ -f "$_f" ] || continue
		_checked=$((_checked + 1))
		"$_cli" dump "$_f" -o "$_t/mine" || { _rc=1; continue; }
		ffmpeg -v error -y -i "$_f" -f s32le -ac 2 "$_t/ff" || { _rc=1; continue; }
		if cmp -s "$_t/mine" "$_t/ff"; then msg "bit-perfect OK: $(basename "$_f")"; else error "bit-perfect FAIL: $(basename "$_f")"; _rc=1; fi
	done
	rm -rf "$_t"
	[ "$_checked" -gt 0 ] || { warning "bit-perfect gate: no files to check"; return 0; }
	[ "$_rc" = 0 ] || { error "bit-perfect gate failed — refusing to package this build"; return 1; }
}

build() {
	cd "$builddir"
	# Native musl/aarch64 build inside the chroot (under qemu for foreign arch):
	# no --target, no linker flags. Tune codegen for the SDM845 (Kryo 385 =
	# Cortex-A75 big + A55 LITTLE, which share the ARMv8.2-A ISA, so a75-tuned code
	# runs safely on both clusters). Set via RUSTFLAGS here — not only in
	# .cargo/config.toml — so it applies regardless of the chroot rustc's exact
	# musl host triple. An env RUSTFLAGS replaces config rustflags (no merge), so
	# everything codegen-related must live here.
	export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-cpu=cortex-a75 -C panic=abort -C llvm-args=-cost-kind=latency"
	_base_rustflags="$RUSTFLAGS"
	_prep_testdata || warning "no training/gate material (testfiles/ absent and ffmpeg synth failed)"
	if _detect_corpus; then
		msg "PGO: real music corpus at $_PGO_MUSIC (rich profile)"
	else
		msg "PGO: no real corpus — bind-mount one (scripts/pmb-build-pgo.sh → /mnt/pgo-music) for a richer profile; using synth workload"
	fi

	if [ "$_pgo" = 1 ] && _pgo_build; then
		msg "PGO build complete"
	else
		msg "Plain release build (PGO off or unavailable — see warnings above)"
		cargo build --profile "$_cargo_profile" --frozen -p player-gtk -p player-cli
	fi

	_bitperfect_gate || return 1

	# --- Phosh quick-settings plugins (the system-curtain tiles) -----------------
	# Out-of-tree GModules under packaging/phosh-plugin-*/ (GTK3 + libhandy): hifi-sync
	# (the "Music sync" share button) and hifi-usb (the Audio/Charging/Sync USB-mode
	# switch). pmOS phosh-dev ships only the entry-point header + the phosh-plugins.pc
	# dir vars; the widget headers (quick-setting.h …) are vendored per-plugin in
	# phosh-vendor/ and the symbols resolve from the running phosh at dlopen time.
	# BEST-EFFORT: a plugin that can't build is skipped (its tile absent, the share +
	# USB switch still work headless via hifi-share / hifi-usb-mode) and the whole
	# block is skipped if the SDK is missing or phosh is outside the vendored ABI band.
	# package() installs whichever plugin trees built.
	_plugin_out="$builddir/target/phosh-plugin"
	rm -rf "$_plugin_out"
	if command -v meson >/dev/null 2>&1 && pkg-config --exists phosh-plugins 2>/dev/null; then
		_phosh_ver=$(pkg-config --modversion phosh-plugins 2>/dev/null || echo '?')
		# Vendored headers (phosh-vendor/) track phosh 0.55.0's GTK3 QS ABI. The QS
		# class struct (GtkBox + 10 reserved vfuncs) is stable across 0.x, so accept
		# the whole 0.4x–0.x band; a 1.x / GTK4 phosh needs re-vendored headers.
		if pkg-config --atleast-version=0.40 phosh-plugins 2>/dev/null \
		   && ! pkg-config --atleast-version=1.0 phosh-plugins 2>/dev/null; then
			for _plug in hifi-sync hifi-usb; do
				msg "Building Phosh quick-settings plugin ($_plug) against phosh $_phosh_ver"
				if meson setup "$_plugin_out/$_plug" "packaging/phosh-plugin-$_plug" \
					--prefix=/usr --libdir=lib && meson compile -C "$_plugin_out/$_plug"; then
					msg "Phosh plugin $_plug built"
				else
					warning "Phosh plugin $_plug build failed — skipping that curtain tile (headless control still works)"
					rm -rf "$_plugin_out/$_plug"
				fi
			done
		else
			warning "phosh $_phosh_ver is outside the vendored QS ABI range (phosh-vendor/ targets 0.55.0) — skipping curtain tiles; re-vendor headers for this release. Share/USB switch still work headless."
		fi
	else
		warning "phosh-plugins SDK not found — skipping curtain tiles (install phosh-dev or build against the Phosh source); share/USB switch still work headless"
	fi
}

package() {
	cd "$builddir"
	# Built by build() as the `release-pgo` profile (PGO/BOLT or plain fallback);
	# abuild strips these during packaging.
	install -Dm755 target/release-pgo/player-gtk "$pkgdir"/usr/bin/player-gtk
	install -Dm755 target/release-pgo/player-cli "$pkgdir"/usr/bin/player-cli

	# Phosh app-grid launcher + icon.
	install -Dm644 "$srcdir"/hifi-player.desktop \
		"$pkgdir"/usr/share/applications/hifi-player.desktop
	install -Dm644 "$srcdir"/hifi-player.svg \
		"$pkgdir"/usr/share/icons/hicolor/scalable/apps/hifi-player.svg

	# systemd service: USB host mode (OTG workaround) + governors + IRQ RT.
	# Shared imperative setup script (also runnable by hand), unit, and the
	# preset that enables it at image build (`systemctl preset-all`).
	install -Dm755 "$srcdir"/hifi-player-audio-setup \
		"$pkgdir"/usr/bin/hifi-player-audio-setup
	install -Dm644 "$srcdir"/hifi-player-audio-setup.service \
		"$pkgdir"/usr/lib/systemd/system/hifi-player-audio-setup.service
	install -Dm644 "$srcdir"/hifi-player.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-hifi-player.preset

	# system-sleep hook: re-assert the audio environment on resume (before any
	# DAC reopen) and quiesce WiFi during sleep so s2idle is effective. Pairs
	# with the player's standby battery saver (PLAYER_STANDBY_TIMEOUT_SECS).
	install -Dm755 "$srcdir"/hifi-player-sleep-hook \
		"$pkgdir"/usr/lib/systemd/system-sleep/hifi-player

	# One-touch "music sync" share: control script + on-demand unit + config, plus
	# the avahi (_sftp-ssh._tcp), sshd (hardening template), and polkit (lets the
	# session user toggle ONLY hifi-share.service) drop-ins. The unit is owned by the
	# curtain button — never enabled at boot — so the Wi-Fi-off/idle posture holds.
	install -Dm755 "$srcdir"/hifi-share \
		"$pkgdir"/usr/bin/hifi-share
	install -Dm644 "$srcdir"/hifi-share.service \
		"$pkgdir"/usr/lib/systemd/system/hifi-share.service
	install -Dm644 "$srcdir"/hifi-share.conf \
		"$pkgdir"/etc/hifi-share.conf
	install -Dm644 "$srcdir"/hifi-share-avahi.service \
		"$pkgdir"/etc/avahi/services/sftp.service
	install -Dm644 "$srcdir"/hifi-share-sshd.conf \
		"$pkgdir"/etc/ssh/sshd_config.d/10-hifi-share.conf
	install -Dm644 "$srcdir"/hifi-share-polkit.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/10-hifi-share.rules

	# Runtime USB port-mode switch (Audio / Charging / Sync): the control script,
	# the templated on-demand unit the curtain tile triggers, and the scoped polkit
	# rule that lets the session user start ONLY hifi-usb-mode@<mode>.service.
	install -Dm755 "$srcdir"/hifi-usb-mode \
		"$pkgdir"/usr/bin/hifi-usb-mode
	install -Dm644 "$srcdir"/hifi-usb-mode@.service \
		"$pkgdir"/usr/lib/systemd/system/hifi-usb-mode@.service
	install -Dm644 "$srcdir"/hifi-usb-mode-polkit.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/10-hifi-usb-mode.rules

	# Phosh quick-settings plugins (.so + .plugin), each only when build() produced it.
	# The gschema override (which makes the tiles appear by default) ships if any built.
	_plugin_out="$builddir/target/phosh-plugin"
	_have_plugin=
	for _plug in hifi-sync hifi-usb; do
		if [ -d "$_plugin_out/$_plug" ]; then
			DESTDIR="$pkgdir" meson install --no-rebuild -C "$_plugin_out/$_plug"
			_have_plugin=1
		fi
	done
	if [ -n "$_have_plugin" ]; then
		install -Dm644 "$srcdir"/zz-hifi-sync.gschema.override \
			"$pkgdir"/usr/share/glib-2.0/schemas/zz-hifi-sync.gschema.override
	fi

	# udev: keep the sound server off the DAC; let the audio group hold cpu_dma_latency.
	install -Dm644 "$srcdir"/99-mojo2-nopulse.rules \
		"$pkgdir"/etc/udev/rules.d/99-mojo2-nopulse.rules
	install -Dm644 "$srcdir"/99-cpu-dma-latency.rules \
		"$pkgdir"/etc/udev/rules.d/99-cpu-dma-latency.rules
	install -Dm644 "$srcdir"/99-volume-keys.rules \
		"$pkgdir"/etc/udev/rules.d/99-volume-keys.rules

	# RT limits, snd-usb-audio module options, swap/dirty tuning.
	install -Dm644 "$srcdir"/99-audio.conf \
		"$pkgdir"/etc/security/limits.d/99-audio.conf
	install -Dm644 "$srcdir"/audio.conf \
		"$pkgdir"/etc/modprobe.d/audio.conf
	install -Dm644 "$srcdir"/99-audio-sysctl.conf \
		"$pkgdir"/etc/sysctl.d/99-audio-sysctl.conf

	# Kernel cmdline additions (applied on the next boot-image rebuild).
	install -Dm644 "$srcdir"/90-audio-cmdline.conf \
		"$pkgdir"/etc/kernel-cmdline.d/90-audio.conf
}

