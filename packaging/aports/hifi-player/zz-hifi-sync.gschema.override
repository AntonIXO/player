# Make the "Music sync" quick-setting plugin appear in the Phosh system-curtain by
# default. `quick-settings` lists CUSTOM plugin tiles only (the built-in Wi-Fi /
# Bluetooth / torch toggles are unaffected), so adding ours doesn't remove anything.
# Named zz- so it applies after any other override; a user choosing plugins in
# Settings writes dconf, which still wins over this default.
[sm.puri.phosh.plugins]
quick-settings=['hifi-sync']
