# Rust build output
/target

# Audio test fixtures — large binaries (and often copyrighted music); not source.
# Generate locally per README, or drop your own files in. Use `git add -f` to
# force-track a specific fixture if you really want it versioned.
*.flac
*.wav
*.m4a
*.aac
*.mp3
*.dsf
*.dff
*.iso
/testfiles/

# C++ SACD reference (sacd-ripper fork) — vendored reference, has its own repo.
/sacd/

# Downloaded LLVM toolchains (e.g. the aarch64 release whose libbolt_rt_instr.a
# feeds cross-arch BOLT instrumentation) — multi-GB binaries, never source.
/LLVM-*/

# Bit-perfect verification artifacts (decoded PCM dumps)
*.s32le
*.raw
*.pcm

# Editor / OS cruft
*.swp
*~
.DS_Store
.idea/
.vscode/

# Claude Code local config (skills, plans, memory) — not project source.
.claude/

# Scratch screenshots (not source).
queue.png
search.png
