+static const struct file_operations dsm_ctrl_fops = {
+	.owner			= THIS_MODULE,
+	.open			= maxdsm_open,
+	.release		= NULL,
+	.unlocked_ioctl = maxdsm_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl	= maxdsm_compat_ioctl,
+#endif /* CONFIG_COMPAT */
+	.read			= maxdsm_read,
+	.write			= maxdsm_write,
+	.mmap			= NULL,
+	.poll			= NULL,
+	.fasync			= NULL,
+	.llseek			= NULL,
+};
