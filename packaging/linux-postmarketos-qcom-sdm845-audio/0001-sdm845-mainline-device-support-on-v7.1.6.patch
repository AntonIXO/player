+	float  cutOffFreq;		/**< cut off frequency in Hertz; range: [100.0 4000.0] */
+	float  samplingFreq;	  /**< sampling frequency in Hertz */
+	float  leakage;			/**< leakage factor; range [0.0 1.0] */
+} TfaIntegratorFilter_t;
