+#ifdef CONFIG_COMPAT
+static long maxdsm_compat_ioctl(struct file *file,
+		unsigned int cmd, unsigned long arg)
+{
+	return maxdsm_ioctl_handler(file, cmd, arg,
+			(void __user *)(unsigned long)arg);
+}
+#endif /* CONFIG_COMPAT */
