+	max98512_wrapper_write(max98512, MAX98512L,
+				MAX98512_R0087_BOOST_BYPASS_2,
+				boost_mode);
+	msg_maxim("mixer set boost[%d]", boost_mode);
+	pdata->boost_mode = boost_mode;
+	return 0;
