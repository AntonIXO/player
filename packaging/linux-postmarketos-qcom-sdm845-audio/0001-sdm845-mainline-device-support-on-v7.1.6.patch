+		/* V25 */
+		tfa_reg_write(tfa, 0x02, 0x22a8); //POR=0x25c8
+		tfa_reg_write(tfa, 0x51, 0x0020); //POR=0x0000
+		tfa_reg_write(tfa, 0x52, 0x57dc); //POR=0x56dc
+		tfa_reg_write(tfa, 0x58, 0x16a4); //POR=0x1614
