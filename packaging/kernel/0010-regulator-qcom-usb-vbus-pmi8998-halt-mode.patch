+/* PMI8998 requires this mode while sourcing VBUS, as in Qualcomm smb-lib.
+ * Without it, a display power transition can latch OTG failure while the
+ * enable bit remains set. Do not change current limits or fault protection.
+ */
+static int qcom_usb_vbus_halt_mode(struct regulator_dev *rdev, bool enable)
+{
+	unsigned int base = rdev->desc->enable_reg - CMD_OTG;
+	int ret;
+
+	if (rdev_get_drvdata(rdev) != &msm_vbus_desc_pmi8998)
+		return 0;
+	ret = regmap_write(rdev->regmap, base + OTG_SEC_ACCESS, OTG_SEC_UNLOCK);
+	if (ret)
+		return ret;
+	return regmap_update_bits(rdev->regmap, base + OTG_ENG_CFG,
+				 OTG_HALT_1_IN_8, enable ? OTG_HALT_1_IN_8 : 0);
+}
+
+static int qcom_usb_vbus_enable(struct regulator_dev *rdev)
+{
+	int ret = qcom_usb_vbus_halt_mode(rdev, true);
+
+	if (ret)
+		return ret;
+	ret = regulator_enable_regmap(rdev);
+	if (ret)
+		qcom_usb_vbus_halt_mode(rdev, false);
+	return ret;
+}
+
+static int qcom_usb_vbus_disable(struct regulator_dev *rdev)
+{
+	int ret = regulator_disable_regmap(rdev);
+
+	if (ret)
+		return ret;
+	return qcom_usb_vbus_halt_mode(rdev, false);
+}
+
 static const struct regulator_ops qcom_usb_vbus_reg_ops = {
-	.enable = regulator_enable_regmap,
-	.disable = regulator_disable_regmap,
+	.enable = qcom_usb_vbus_enable,
+	.disable = qcom_usb_vbus_disable,
 	.is_enabled = regulator_is_enabled_regmap,
